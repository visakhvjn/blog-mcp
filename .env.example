# MongoDB (Atlas): mongodb+srv://user:pass@cluster.mongodb.net/blog-mcp?retryWrites=true&w=majority
DATABASE_URL=

# Auth0 (https://manage.auth0.com) — Regular Web Application
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Auth0 API identifier (create API in Auth0 dashboard) — used for ChatGPT MCP OAuth tokens
AUTH0_AUDIENCE=https://blog-mcp-api

# For Cursor MCP (.cursor/mcp.json uses ${env:BLOG_MCP_API_KEY})
# Generate a key at /dashboard/settings after sign-in
BLOG_MCP_API_KEY=
