# MongoDB (Atlas): mongodb+srv://user:pass@cluster.mongodb.net/blog-mcp?retryWrites=true&w=majority
DATABASE_URL=

# openssl rand -base64 32
AUTH_SECRET=

# Google Cloud Console → OAuth 2.0 Client (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# App URL (no trailing slash)
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# For Cursor MCP (.cursor/mcp.json uses ${env:BLOG_MCP_API_KEY})
# Generate a key at /dashboard/settings after sign-in
BLOG_MCP_API_KEY=
